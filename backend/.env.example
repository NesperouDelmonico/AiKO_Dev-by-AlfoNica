NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000
API_BODY_LIMIT=100kb
TRUST_PROXY=false
SWAGGER_ENABLED=false
RATE_LIMIT_MAX=100
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-locally
DB_NAME=aiko
# Supabase exige SSL. Con Postgres local (Docker) dejar en false.
DB_SSL=false
# Opcional: certificado CA en PEM (con \n) para verificar el servidor.
DB_SSL_CA=
# Conexiones por instancia. En Vercel usar 1-3.
DB_POOL_MAX=10
# Vacíos = comportamiento por defecto (synchronize en desarrollo, migraciones
# al arrancar en producción). En Vercel/Supabase ponerlos en false.
DB_SYNCHRONIZE=
DB_MIGRATIONS_RUN=
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_EXPIRES_IN=8h
MIN_SCORE_TO_ADVANCE=60
XP_PER_LEVEL=100
XP_REFERENCE_TIME_MS=10000
XP_PRECISION_DIVISOR=10
XP_SPEED_BONUS_MAX=5
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Despliegue serverless (Vercel) ---
# false = no registra los @Cron; las tareas se disparan por HTTP (/v1/cron/*).
SCHEDULER_ENABLED=true
# Secreto (mínimo 16 caracteres) que Vercel Cron envía como Bearer.
CRON_SECRET=
